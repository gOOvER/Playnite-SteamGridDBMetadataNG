<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <ProjectGuid>{13C224DB-2CF0-4876-A7FD-0DB4F4D6690F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>SGDBMetadata</RootNamespace>
    <AssemblyName>SGDBMetadata</AssemblyName>
    <TargetFramework>net462</TargetFramework>
    <UseWpf>true</UseWpf>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- Suppress NuGet audit warning for Newtonsoft.Json 10.0.3 which is required by Playnite runtime host -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="PlayniteSDK" Version="6.18.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="RestSharp" Version="106.15.0" />
  </ItemGroup>

  <!-- App.xaml for XAML design-time preview -->
  <ItemGroup>
    <ApplicationDefinition Remove="app.xaml" />
    <Page Include="app.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- Localization files must be Content (copied to output), not compiled XAML Pages -->
  <ItemGroup>
    <Page Remove="Localization\**" />
    <Content Include="Localization\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Files to copy to output directory -->
  <ItemGroup>
    <None Update="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PackOnRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and Exists('$(LOCALAPPDATA)\Playnite\Toolbox.exe')">
    <Exec Command="&quot;$(LOCALAPPDATA)\Playnite\Toolbox.exe&quot; pack &quot;$(TargetDir.TrimEnd('\'))&quot; &quot;$(ProjectDir)bin&quot;" />
  </Target>
</Project>